{
  "name": "pi-browser-actions",
  "version": "1.0.2",
  "description": "Stateful Playwright browser automation for Pi with headed or headless launch, browser attachment, web search, exact URL fetching, rendering, and Markdown extraction.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "browser",
    "playwright",
    "automation",
    "web-search",
    "web-fetch"
  ],
  "exports": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiobonfiglio/pi-browser-actions.git"
  },
  "homepage": "https://github.com/sergiobonfiglio/pi-browser-actions#readme",
  "bugs": {
    "url": "https://github.com/sergiobonfiglio/pi-browser-actions/issues"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "setup": "playwright install chromium",
    "setup:ci": "playwright install --with-deps chromium",
    "setup:browsers": "playwright install chromium firefox webkit",
    "setup:edge": "playwright install msedge",
    "smoke": "node test/smoke.mjs",
    "smoke:attach": "node test/attach-smoke.mjs",
    "smoke:headed": "node test/smoke.mjs --headed",
    "pack:dry": "npm pack --dry-run",
    "release:check": "npm run check && npm run test && npm run smoke && npm run smoke:attach && npm run pack:dry",
    "publish:public": "npm publish --access public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@playwright/cli": "0.1.19",
    "jsdom": "30.0.1",
    "sharp": "0.35.4",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "5.0.6",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
